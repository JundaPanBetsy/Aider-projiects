+# -*- coding: utf-8 -*-
+"""
+Spyder 编辑器
+
+这是一个临时脚本文件。
+"""
+
+class Student: #定义一个学生类
+    def __init__(self,Student_ID,name,score): #初始化
+        self.name=name
+        self.Student_ID=Student_ID
+        self.score=score
+        self.next=None
+        
+    def __repr__(self): #定义对象的字符串表示，打印对象时自动调用，展示学生信息
+        return str(self.Student_ID)+"\t\t"+self.name+"\t\t"+str(self.score)
+
+class ScoreList:
+    def __init__(self):
+        self.head=None
+    def Create(self):
+        self.head=Student(2018001,"王华",99)
+        p2=Student(2018011,"刘丽",62)
+        p3=Student(2018006,"陈明",54)
+        p4=Student(2018009,"张强",95)
+        p5=Student(2018012,"李萍",88)
+        self.head.next=p2
+        p2.next=p3
+        p3.next=p4
+        p4.next=p5
+        p5.next=None
+    
+    def PrintList(self):
+        p=self.head
+        while p!=None:
+            print(p)
+            p=p.next
+            
+link=ScoreList()
+link.Create()
+link.PrintList()
+请帮我分析拆解我的代码，教我如何正确创建链式存储

